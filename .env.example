# Local defaults need no configuration. Copy to .env and export for AWS-like behaviour.
APP_ENV=local
DATA_DIR=./var
# DATABASE_URL=postgresql://user:pass@host:5432/resource_engine
AUTH_MODE=local                 # local | cognito
JWT_SECRET=change-me
LLM_BACKEND=mock                # mock | bedrock
BEDROCK_MODEL_ID=
WEBSITE_BACKEND=sample          # sample | live
SEARCH_BACKEND=memory           # memory | opensearch
BLOB_BACKEND=local              # local | s3
ORG_DESCRIPTION_POLICY=fallback # fallback | quarantine
DEFAULT_TIMEZONE=America/Los_Angeles
SCHEDULER_ENABLED=false
# HTTPS endpoints for your supplied mocked APIs or an authorized live feed.
ODRS_API_URL=
NDP_API_URL=
# ODRS_TOKEN and NDP_TOKEN are optional bearer values when the endpoint requires them.
# TEST_DATABASE_URL is only for disposable PostgreSQL integration test schemas.

# Self-sized daily maintenance, plus explicit per-run overrides.
MAINTENANCE_RECHECK_DAYS=30
MAINTENANCE_SAFETY_FACTOR=1.2
MAINTENANCE_MAX_BATCH=0
