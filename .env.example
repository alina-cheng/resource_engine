# Local defaults need no configuration. Copy to .env and export for AWS-like behaviour.
APP_ENV=local
DATA_DIR=./var
# DATABASE_URL=postgresql://user:pass@host:5432/resource_engine
AUTH_MODE=local                 # local | cognito
JWT_SECRET=change-me
LLM_BACKEND=mock                # mock | bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
WEBSITE_BACKEND=sample          # sample | live
SEARCH_BACKEND=memory           # memory | opensearch
BLOB_BACKEND=local              # local | s3
ORG_DESCRIPTION_POLICY=fallback # fallback | quarantine
DEFAULT_TIMEZONE=America/Los_Angeles
SCHEDULER_ENABLED=false
