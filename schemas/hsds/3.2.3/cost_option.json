{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cost_option.json",
  "title": "cost_option",
  "type": "object",
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "service_id": {
      "type": "string",
      "format": "uuid"
    },
    "valid_from": {
      "type": "string"
    },
    "valid_to": {
      "type": "string"
    },
    "option": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "amount_description": {
      "type": "string"
    }
  }
}
