{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "service_at_location.json",
  "title": "service_at_location",
  "type": "object",
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "service_id": {
      "type": "string",
      "format": "uuid"
    },
    "location_id": {
      "type": "string",
      "format": "uuid"
    },
    "description": {
      "type": "string"
    },
    "phones": {
      "type": "array",
      "items": {
        "$ref": "phone.json"
      }
    },
    "schedules": {
      "type": "array",
      "items": {
        "$ref": "schedule.json"
      }
    }
  }
}
