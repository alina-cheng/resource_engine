{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "accessibility.json",
  "title": "accessibility",
  "type": "object",
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "location_id": {
      "type": "string",
      "format": "uuid"
    },
    "description": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "url": {
      "type": "string"
    }
  }
}
