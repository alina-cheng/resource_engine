{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "url.json",
  "title": "url",
  "type": "object",
  "required": [
    "id",
    "url"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "label": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "service_id": {
      "type": "string",
      "format": "uuid"
    }
  }
}
