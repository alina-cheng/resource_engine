{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taxonomy.json",
  "title": "taxonomy",
  "type": "object",
  "required": [
    "id",
    "name",
    "description"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "uri": {
      "type": "string"
    },
    "version": {
      "type": "string"
    }
  }
}
