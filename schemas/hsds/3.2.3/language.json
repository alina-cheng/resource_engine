{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "language.json",
  "title": "language",
  "type": "object",
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "service_id": {
      "type": "string",
      "format": "uuid"
    },
    "location_id": {
      "type": "string",
      "format": "uuid"
    },
    "phone_id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  }
}
